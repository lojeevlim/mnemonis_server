# Copy to .env and adjust. Placeholder values only.
# Operator-side only: run `npm run db:migrate` (applies migrations/*.sql, including the accounts schema, login throttle and RLS-on-no-policies).
# Operator CLI (forgotten password, disable, unlock, legacy import): `npm run user -- <command>` (see the README).
# On a hosted Postgres use the connection string of the DB owner role; rotate the DB password if it was ever shared.
DATABASE_URL=postgres://mnemonis:change-me@localhost:5432/mnemonis
# POSTGRES_PASSWORD is required by docker-compose and must match the password in both URLs.
# docker/initdb creates mnemonis_test on first volume init.
# Only used by the pgStore tests (use a throwaway database):
TEST_DATABASE_URL=postgres://mnemonis:change-me@localhost:5432/mnemonis_test
POSTGRES_USER=mnemonis
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mnemonis
# Host port for the container (change if 5432 is taken):
POSTGRES_PORT=5432

# --- mnemonis_api: the API server (this project). Port 8787. The MCP adapter (../mnemonis_mcp) is a separate process on 8788. ---
# Listen address / port of the API
# HOST=127.0.0.1
# PORT=8787
# The MCP adapter's public URL, published by GET /api/auth/config and shown by the web app in the `claude mcp add` command.
# https (or http on localhost), path /mcp, no credentials/query/fragment. Default: http://localhost:8788/mcp
# MNEMONIS_MCP_URL=http://localhost:8788/mcp
# MNEMONIS_PUBLIC_MCP_URL is accepted as an alias (the design doc's name); MNEMONIS_MCP_URL wins if both are set.
# The host may only contain letters, digits, dots and hyphens (or be a bracketed IPv6 literal): the URL is printed in a shell command.
# Shared secret with the MCP adapter (same value as the adapter's MNEMONIS_ADAPTER_SECRET; 16-256 printable ASCII, no spaces).
# When set, the X-Forwarded-For sent by the adapter (the real MCP client's IP) is honoured on /api/agent/* ONLY, and only for
# requests carrying a matching X-Mnemonis-Adapter-Secret header; so each MCP client gets its own failed-auth bucket instead of
# all of them sharing the adapter's address. Unset = the socket address is always used. Never logged.
# MNEMONIS_ADAPTER_SECRET=
# Inbox cap: unreviewed agent changes per user (default 200)
# MNEMONIS_MAX_PENDING=200
# Per-user limits of the internal /api/agent/* surface used by the adapter (shared by all of the user's tokens)
# MNEMONIS_AGENT_WRITES_PER_MINUTE=60
# MNEMONIS_AGENT_READS_PER_MINUTE=300

# --- Accounts / HTTP (names and placeholders only) ---
# The server has its own accounts: users register and log in from the web app (or with curl, see the README).
# Open self-registration. Default: true only when HOST is loopback (127.0.0.1/localhost/::1), otherwise false.
# Setting it true on a non-loopback HOST requires an explicit MNEMONIS_ALLOWED_ORIGINS (the server refuses to start otherwise).
# MNEMONIS_ALLOW_REGISTRATION=true
# Optional registration allowlist: comma-separated exact emails (local@domain) or whole domains (@domain). Empty = anyone may register.
# MNEMONIS_ALLOWED_EMAILS=you@example.com,@example.org
# Hard cap on the number of accounts (default 100)
# MNEMONIS_MAX_USERS=100
# Login sessions: idle expiry (days since last use, default 7) and absolute maximum lifetime (days, default 30)
# MNEMONIS_SESSION_IDLE_DAYS=7
# MNEMONIS_SESSION_MAX_DAYS=30
# Comma-separated browser origins allowed to call the API (exact match)
# MNEMONIS_ALLOWED_ORIGINS=https://app.example.com
# Comma-separated Host header values accepted by the server. Must include the host:port the MCP adapter uses to reach this API
# (e.g. api:8787 in docker compose); loopback with the server's port is always accepted.
# MNEMONIS_ALLOWED_HOSTS=api.example.com
# Set true only behind a trusted reverse proxy, and only if the app is reachable solely through it.
# The per-client rate limiters (login, register, failed-auth), the login throttle and the audit IP bucket use X-Forwarded-For (the LAST entry, appended by your proxy, only if it is a valid IP).
# With a non-loopback HOST and this unset the server prints a loud warning at start: behind a proxy all clients share one bucket.
# MNEMONIS_TRUST_PROXY=false
# Per-user storage quotas, enforced on every write path (defaults: 5 MB of serialized workspace, 5000 memories)
# MNEMONIS_MAX_WORKSPACE_BYTES=5242880
# MNEMONIS_MAX_MEMORIES=5000
# Concurrent password hashes (1-16, default 2: each one occupies a libuv threadpool thread)
# MNEMONIS_HASH_CONCURRENCY=2
# SAFETY: the server, db:migrate, `npm run user`, tests and smoke refuse a DATABASE_URL / TEST_DATABASE_URL whose host is not
# localhost, 127.0.0.1 or ::1. Set this to true ONLY when you really mean to use a remote database.
# MNEMONIS_ALLOW_REMOTE_DB=false
# Max active MCP tokens per user (1-1000, default 20)
# MNEMONIS_MAX_MCP_TOKENS=20
# Run pending migrations on server start (1/true). Otherwise run `npm run db:migrate` yourself.
# MNEMONIS_AUTO_MIGRATE=false
# --- Operator CLI (npm run cli): reads ONLY MNEMONIS_API_URL from this file ---
# Server the CLI talks to (default http://127.0.0.1:8787). https, or http only for localhost; no credentials/query/fragment
# MNEMONIS_API_URL=http://127.0.0.1:8787
